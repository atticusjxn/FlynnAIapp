// Shared build settings — safe to commit

PRODUCT_BUNDLE_IDENTIFIER = com.flynnai.app
IPHONEOS_DEPLOYMENT_TARGET = 17.0
SWIFT_VERSION = 6.0
TARGETED_DEVICE_FAMILY = 1

// Supabase project URL (public, not secret)
SUPABASE_URL = https:/$()/zvfeafmmtfplzpnocyjw.supabase.co

// Flynn telephony / API base
FLYNN_API_BASE_URL = https:/$()/flynnai-telephony.fly.dev

// PostHog. The project key is a publishable client key, not a secret — the
// same one is already embedded in the landing page's JavaScript. It only
// permits writes, which is why it can ship in a client bundle.
POSTHOG_API_KEY = phc_BHXAEfwYDkbwoHQANDTMnDj9XwhFPFECLSeA4cs4r94C
POSTHOG_HOST = https:/$()/us.i.posthog.com

// Facebook / Meta SDK — real values live in Secrets.local.xcconfig (gitignored).
// Get these from developers.facebook.com → My Apps → FlynnAI → Settings → Basic.
FACEBOOK_APP_ID =
FACEBOOK_CLIENT_TOKEN =

// TikTok Business SDK — real values live in Secrets.local.xcconfig.
// Get these from TikTok Events Manager → App → Setup. TIKTOK_APP_ID is your
// iOS bundle id; TIKTOK_TTAPP_ID is the numeric app id TikTok generates.
TIKTOK_APP_ID =
TIKTOK_TTAPP_ID =

// Australian Business Register web services GUID — powers "search your
// business name, get your ABN" on the Getting Paid screen. Free; register at
// abr.business.gov.au/Tools/WebServices. Not a credential (it identifies the
// caller for rate limiting), but kept out of the repo with the other config.
// Leave empty and the app quietly falls back to typing the ABN by hand.
ABR_GUID =

#include? "Secrets.local.xcconfig"
